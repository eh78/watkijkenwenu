# TMDB "API Read Access Token" (v4) — https://www.themoviedb.org/settings/api
# Alleen server-side gebruikt; NOOIT prefixen met NEXT_PUBLIC_.
TMDB_READ_TOKEN=

# Radarr (optioneel). Normaal stel je dit in via /instellingen in de app.
# Vul je deze variabelen in, dan gaan ze voor en is de koppeling voor iedereen gelijk.
# RADARR_URL=http://localhost:7878
# RADARR_API_KEY=
# RADARR_QUALITY_PROFILE_ID=   # leeg = eerste profiel uit Radarr
# RADARR_ROOT_FOLDER=          # leeg = eerste map uit Radarr
# RADARR_SEARCH_ON_ADD=true

# Zet op false bij een publiek gehoste versie: dan kunnen bezoekers geen
# Radarr-adres invullen (en de server dus niet naar willekeurige adressen sturen).
# RADARR_UI_SETUP=true
